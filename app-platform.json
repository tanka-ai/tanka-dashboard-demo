{
  "appId": "dashboard-demo",
  "name": "Engineering Dashboard",
  "kind": "dashboard",
  "runtime": "nextjs",
  "deployment": {
    "provider": "vercel",
    "status": "local-prototype"
  },
  "connectors": {
    "provider": "tanka-link-mcp",
    "runtimeEnv": {
      "baseUrl": "TANKA_LINK_MCP_BASE_URL",
      "userId": "TANKA_TEST_USER_ID"
    },
    "discoveryEndpoints": {
      "listTools": "/api/apps/dashboard-demo/connectors/{app}/tools",
      "callTool": "/api/apps/dashboard-demo/connectors/{app}/call"
    }
  }
}